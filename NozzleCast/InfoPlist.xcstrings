    "NSCameraUsageDescription" : {
      "comment" : "Shown by iOS when the app first requests camera access, to scan filament barcodes and labels.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast uses the camera to scan filament barcodes and labels."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast 使用相机扫描耗材条码和标签。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast verwendet die Kamera, um Barcodes und Etiketten von Filament zu scannen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast utilise la caméra pour lire les codes-barres et les étiquettes de filament."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast usa la cámara para escanear códigos de barras y etiquetas de filamento."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast usa la fotocamera per scansionare codici a barre ed etichette dei filamenti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NozzleCast usa a câmera para ler códigos de barras e etiquetas de filamento."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast gebruikt de camera om streepjescodes en labels van filament te scannen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast använder kameran för att skanna streckkoder och etiketter på filament."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast używa kamery do skanowania kodów kreskowych i etykiet filamentu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast использует камеру для сканирования штрихкодов и этикеток филамента."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast використовує камеру для сканування штрихкодів і етикеток філаменту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast, filament barkodlarını ve etiketlerini taramak için kamerayı kullanır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast はフィラメントのバーコードとラベルをスキャンするためにカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast는 필라멘트 바코드와 라벨을 스캔하기 위해 카메라를 사용합니다."
          }
        },
