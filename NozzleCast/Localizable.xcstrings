    "No match in the Open Filament Database or SpoolmanDB-Community. Fill in the details below and it'll be added as entered." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开放耗材数据库和 SpoolmanDB-Community 中均无匹配项。填写下方详情后将按所填内容添加。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Treffer in der Open Filament Database oder SpoolmanDB-Community. Füllen Sie die Angaben unten aus; sie werden so hinzugefügt, wie Sie sie eingeben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun résultat dans l’Open Filament Database ou SpoolmanDB-Community. Remplissez les détails ci-dessous et la bobine sera ajoutée telle que saisie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin coincidencias en Open Filament Database ni en SpoolmanDB-Community. Rellene los datos de abajo y se añadirá tal como lo introduzca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun risultato in Open Filament Database o SpoolmanDB-Community. Compila i dettagli qui sotto e verrà aggiunta così come la inserisci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada encontrado no Open Filament Database nem no SpoolmanDB-Community. Preencha os dados abaixo e ele será adicionado como informado."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen resultaat in de Open Filament Database of SpoolmanDB-Community. Vul de gegevens hieronder in; ze worden toegevoegd zoals ingevoerd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen träff i Open Filament Database eller SpoolmanDB-Community. Fyll i uppgifterna nedan så läggs den till som angiven."
