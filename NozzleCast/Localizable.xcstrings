    "Your API key can't read your server's notifications. Give it the notifications:read permission." : {
      "comment" : "Alert feed error: API key lacks permission",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 密钥无法读取服务器通知，请授予 notifications:read 权限。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr API-Schlüssel darf die Benachrichtigungen Ihres Servers nicht lesen. Geben Sie ihm die Berechtigung notifications:read."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé API ne peut pas lire les notifications de votre serveur. Accordez-lui l’autorisation notifications:read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su clave de API no puede leer las notificaciones de su servidor. Concédale el permiso notifications:read."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua chiave API non può leggere le notifiche del server. Concedile il permesso notifications:read."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua chave de API não pode ler as notificações do servidor. Dê a ela a permissão notifications:read."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je API-sleutel mag de meldingen van je server niet lezen. Geef hem het recht notifications:read."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din API-nyckel kan inte läsa serverns notiser. Ge den behörigheten notifications:read."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój klucz API nie może odczytać powiadomień serwera. Nadaj mu uprawnienie notifications:read."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш ключ API не может читать уведомления сервера. Выдайте ему разрешение notifications:read."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш ключ API не може читати сповіщення сервера. Надайте йому дозвіл notifications:read."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API anahtarınız sunucunuzun bildirimlerini okuyamıyor. Ona notifications:read iznini verin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API キーにサーバーの通知を読み取る権限がありません。notifications:read の権限を付与してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 키에 서버 알림을 읽을 권한이 없습니다. notifications:read 권한을 부여하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 API 金鑰無法讀取伺服器的通知。請授予 notifications:read 權限。"
          }
        }
      }
    },
    "Your self-hosted nozzlecast-relay's URL and RELAY_AUTH_SECRET. This lets a Live Activity start the instant a print begins, even while your phone is locked." : {
      "comment" : "A description of the Push-to-Start Relay.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你自建 nozzlecast-relay 的 URL 和 RELAY_AUTH_SECRET。有了它，打印一开始即可启动实时活动，即使手机处于锁定状态。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL und RELAY_AUTH_SECRET Ihres selbst gehosteten nozzlecast-relay. Damit startet eine Live-Aktivität sofort, wenn ein Druck beginnt – auch wenn Ihr iPhone gesperrt ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’URL et le RELAY_AUTH_SECRET de votre nozzlecast-relay auto-hébergé. Une activité en direct peut ainsi démarrer dès le début d’une impression, même téléphone verrouillé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La URL y el RELAY_AUTH_SECRET de su nozzlecast-relay autoalojado. Así una actividad en vivo empieza en cuanto arranca una impresión, aunque el teléfono esté bloqueado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’URL e il RELAY_AUTH_SECRET del tuo nozzlecast-relay self-hosted. Così un’Attività Live parte appena inizia una stampa, anche con il telefono bloccato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A URL e o RELAY_AUTH_SECRET do seu nozzlecast-relay auto-hospedado. Assim uma Atividade ao Vivo começa no instante em que a impressão inicia, mesmo com o celular bloqueado."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De URL en RELAY_AUTH_SECRET van je zelf gehoste nozzlecast-relay. Daarmee start een Live Activity zodra een print begint, ook als je telefoon vergrendeld is."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL och RELAY_AUTH_SECRET för ditt egenhostade nozzlecast-relay. Då startar en Live-aktivitet så fort en utskrift börjar, även när telefonen är låst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adres URL i RELAY_AUTH_SECRET twojego samodzielnie hostowanego nozzlecast-relay. Dzięki temu aktywność na żywo startuje w chwili rozpoczęcia wydruku, nawet gdy telefon jest zablokowany."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL и RELAY_AUTH_SECRET вашего самостоятельно размещённого nozzlecast-relay. Тогда Live Activity запускается в момент начала печати, даже если телефон заблокирован."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL-адреса та RELAY_AUTH_SECRET вашого самостійно розміщеного nozzlecast-relay. Тоді Live Activity запускається тієї миті, коли починається друк, навіть якщо телефон заблоковано."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi barındırdığınız nozzlecast-relay’in URL’si ve RELAY_AUTH_SECRET değeri. Böylece bir Canlı Etkinlik, telefonunuz kilitliyken bile baskı başladığı anda başlar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セルフホストしている nozzlecast-relay の URL と RELAY_AUTH_SECRET。これにより、iPhone がロック中でも印刷開始と同時にライブアクティビティが始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 호스팅하는 nozzlecast-relay의 URL과 RELAY_AUTH_SECRET입니다. 이를 통해 iPhone이 잠겨 있어도 인쇄가 시작되는 즉시 실시간 현황이 시작됩니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你自架的 nozzlecast-relay 的網址與 RELAY_AUTH_SECRET。這樣即使手機已鎖定，即時動態也會在列印開始的瞬間啟動。"
          }
        }
      }
    },
    "Your server couldn't reach Spoolman to look this spool up. Place it again once Spoolman is back." : {
      "comment" : "SpoolBuddy scan: lookup failed, Spoolman down",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器无法连接 Spoolman 查询此耗材，待 Spoolman 恢复后重新放置。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Server konnte Spoolman nicht erreichen, um diese Spule nachzuschlagen. Legen Sie sie erneut auf, sobald Spoolman wieder verfügbar ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur n’a pas pu joindre Spoolman pour rechercher cette bobine. Reposez-la quand Spoolman sera de retour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su servidor no pudo contactar con Spoolman para buscar esta bobina. Vuelva a colocarla cuando Spoolman esté disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non è riuscito a raggiungere Spoolman per cercare questa bobina. Rimettila quando Spoolman tornerà disponibile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor não conseguiu acessar o Spoolman para pesquisar este carretel. Coloque-o de novo quando o Spoolman voltar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je server kon Spoolman niet bereiken om deze spoel op te zoeken. Leg hem opnieuw neer zodra Spoolman weer werkt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern kunde inte nå Spoolman för att slå upp den här rullen. Lägg på den igen när Spoolman är tillbaka."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer nie mógł połączyć się ze Spoolmanem, aby wyszukać tę szpulę. Połóż ją ponownie, gdy Spoolman znów będzie dostępny."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер не смог связаться со Spoolman, чтобы найти эту катушку. Положите её снова, когда Spoolman заработает."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер не зміг зв’язатися зі Spoolman, щоб знайти цю котушку. Покладіть її знову, коли Spoolman запрацює."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunuz bu makarayı aramak için Spoolman’e ulaşamadı. Spoolman geri geldiğinde makarayı yeniden koyun."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーがこのスプールを検索するために Spoolman に接続できませんでした。Spoolman が復旧したら、もう一度置いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 이 스풀을 검색하기 위해 Spoolman에 연결하지 못했습니다. Spoolman이 다시 작동하면 다시 올려놓으세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的伺服器無法連線到 Spoolman 查詢此料盤。Spoolman 恢復後請再放一次。"
          }
        }
      }
    },
    "Your server hit an error looking this spool up. Place it on the SpoolBuddy again." : {
      "comment" : "SpoolBuddy scan: lookup failed",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器查询此耗材时出错，请重新放到 SpoolBuddy 上。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Ihrem Server ist beim Nachschlagen dieser Spule ein Fehler aufgetreten. Legen Sie sie erneut auf den SpoolBuddy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur a rencontré une erreur en recherchant cette bobine. Reposez-la sur le SpoolBuddy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su servidor tuvo un error al buscar esta bobina. Vuelva a colocarla en el SpoolBuddy."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha avuto un errore cercando questa bobina. Rimettila sullo SpoolBuddy."
          }
        },
        "pt-BR" : {
