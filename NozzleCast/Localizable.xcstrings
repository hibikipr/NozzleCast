          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern registrerar den som klar nu och startar om intervallet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer zapisze je jako wykonane teraz i rozpocznie odliczanie od nowa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер отметит её выполненной сейчас и начнёт интервал заново."
          }
