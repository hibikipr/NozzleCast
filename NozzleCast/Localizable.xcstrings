    "Showing demo data. Tap Server to connect to your server instance." : {
      "comment" : "Settings footer: no server configured",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demodaten werden angezeigt. Tippen Sie auf „Server“, um sich mit Ihrem Server zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
