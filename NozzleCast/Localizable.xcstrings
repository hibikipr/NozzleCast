    "Import the GoogleService-Info.plist from the Firebase project your ntfy server publishes through. NozzleCast will subscribe to the same alert topic your server already sends to." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 ntfy 服务器所发布的 Firebase 项目中导入 GoogleService-Info.plist。NozzleCast 将订阅服务器已在发送的同一告警主题。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importieren Sie die GoogleService-Info.plist aus dem Firebase-Projekt, über das Ihr ntfy-Server veröffentlicht. NozzleCast abonniert dasselbe Warnungsthema, an das Ihr Server bereits sendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez le fichier GoogleService-Info.plist du projet Firebase par lequel publie votre serveur ntfy. NozzleCast s’abonnera au même sujet d’alertes que celui où votre serveur envoie déjà."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe el GoogleService-Info.plist del proyecto Firebase a través del que publica su servidor ntfy. NozzleCast se suscribirá al mismo tema de alertas al que su servidor ya envía."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa il GoogleService-Info.plist del progetto Firebase tramite cui pubblica il tuo server ntfy. NozzleCast si iscriverà allo stesso argomento degli avvisi a cui il server invia già."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe o GoogleService-Info.plist do projeto Firebase pelo qual o seu servidor ntfy publica. O NozzleCast vai assinar o mesmo tópico de alertas para o qual o servidor já envia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importeer de GoogleService-Info.plist uit het Firebase-project waarlangs je ntfy-server publiceert. NozzleCast abonneert zich op hetzelfde meldingsonderwerp waar je server al naartoe stuurt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importera GoogleService-Info.plist från Firebase-projektet som din ntfy-server publicerar via. NozzleCast prenumererar på samma larmämne som servern redan skickar till."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaimportuj GoogleService-Info.plist z projektu Firebase, przez który publikuje twój serwer ntfy. NozzleCast zasubskrybuje ten sam temat alertów, na który serwer już wysyła."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортируйте GoogleService-Info.plist из проекта Firebase, через который публикует ваш сервер ntfy. NozzleCast подпишется на ту же тему оповещений, куда сервер уже отправляет."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імпортуйте GoogleService-Info.plist із проєкту Firebase, через який публікує ваш сервер ntfy. NozzleCast підпишеться на ту саму тему сповіщень, куди сервер уже надсилає."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ntfy sunucunuzun yayın yaptığı Firebase projesinin GoogleService-Info.plist dosyasını içe aktarın. NozzleCast, sunucunuzun zaten gönderdiği aynı uyarı konusuna abone olur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ntfy サーバーが配信に使っている Firebase プロジェクトの GoogleService-Info.plist を読み込んでください。NozzleCast は、サーバーがすでに送信しているのと同じアラートトピックを購読します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ntfy 서버가 게시하는 Firebase 프로젝트의 GoogleService-Info.plist를 가져오세요. NozzleCast가 서버가 이미 보내는 것과 같은 경고 토픽을 구독합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯入你的 ntfy 伺服器發佈時所用 Firebase 專案的 GoogleService-Info.plist。NozzleCast 會訂閱伺服器已在發送的同一警報主題。"
          }
        }
      }
    },
