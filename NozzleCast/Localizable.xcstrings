    "Developer LAN mode is off on %@, so it won't accept a print from your server." : {
      "comment" : "Why a queued print can't be started",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已关闭开发者 LAN 模式，因此不会接受来自服务器的打印任务。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Entwickler-LAN-Modus ist auf %@ aus, daher nimmt er keinen Druck von Ihrem Server an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode LAN développeur est désactivé sur %@ : elle n’acceptera pas d’impression de votre serveur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo LAN de desarrollador está desactivado en %@, así que no aceptará impresiones de su servidor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità LAN sviluppatore è disattivata su %@, quindi non accetterà stampe dal tuo server."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo LAN de desenvolvedor está desativado na %@, então ela não aceitará impressões do seu servidor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De LAN-ontwikkelaarsmodus staat uit op %@, dus hij accepteert geen print van je server."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utvecklar-LAN-läget är avstängt på %@, så den tar inte emot utskrifter från din server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb LAN dewelopera jest wyłączony w %@, więc drukarka nie przyjmie wydruku z serwera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На %@ выключен режим LAN для разработчиков, поэтому он не примет печать с вашего сервера."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На %@ вимкнено режим LAN для розробників, тож він не прийме друк з вашого сервера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ üzerinde Geliştirici LAN modu kapalı, bu yüzden sunucunuzdan baskı kabul etmeyecek."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の開発者 LAN モードがオフのため、サーバーからの印刷を受け付けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 개발자 LAN 모드가 꺼져 있어 서버에서 보낸 인쇄를 받지 않습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的開發者 LAN 模式已關閉，因此不會接受來自你伺服器的列印。"
          }
        }
      }
    },
    "Developer LAN mode is off on this printer, so it won't accept this command. Turn it on in the printer's LAN settings." : {
      "comment" : "Error message shown when a printer refuses a command because Developer LAN mode is off.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此打印机已关闭开发者 LAN 模式，不会接受该命令。请在打印机 LAN 设置中开启。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Entwickler-LAN-Modus ist auf diesem Drucker aus, daher nimmt er diesen Befehl nicht an. Aktivieren Sie ihn in den LAN-Einstellungen des Druckers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode LAN développeur est désactivé sur cette imprimante : elle n’acceptera pas cette commande. Activez-le dans les réglages LAN de l’imprimante."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo LAN de desarrollador está desactivado en esta impresora, así que no aceptará este comando. Actívelo en los ajustes LAN de la impresora."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità LAN sviluppatore è disattivata su questa stampante, quindi non accetterà questo comando. Attivala nelle impostazioni LAN della stampante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo LAN de desenvolvedor está desativado nesta impressora, então ela não aceitará este comando. Ative-o nos ajustes de LAN da impressora."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De LAN-ontwikkelaarsmodus staat uit op deze printer, dus hij accepteert deze opdracht niet. Zet hem aan in de LAN-instellingen van de printer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utvecklar-LAN-läget är avstängt på den här skrivaren, så den tar inte emot kommandot. Slå på det i skrivarens LAN-inställningar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb LAN dewelopera jest wyłączony w tej drukarce, więc nie przyjmie tego polecenia. Włącz go w ustawieniach LAN drukarki."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом принтере выключен режим LAN для разработчиков, поэтому он не примет эту команду. Включите его в настройках LAN принтера."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цьому принтері вимкнено режим LAN для розробників, тож він не прийме цю команду. Увімкніть його в налаштуваннях LAN принтера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yazıcıda Geliştirici LAN modu kapalı, bu yüzden bu komutu kabul etmeyecek. Yazıcının LAN ayarlarından açın."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプリンターの開発者 LAN モードがオフのため、このコマンドを受け付けません。プリンターの LAN 設定でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프린터의 개발자 LAN 모드가 꺼져 있어 이 명령을 받지 않습니다. 프린터의 LAN 설정에서 켜세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此印表機的開發者 LAN 模式已關閉，因此不會接受此指令。請在印表機的 LAN 設定中開啟。"
          }
        }
      }
    },
    "Developer LAN mode is off on this printer. Assigning still saves, but the printer will reject the slot settings your server sends and show an \"MQTT command verification failed\" error." : {
      "comment" : "Assign sheet note for a printer without Developer LAN mode",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此打印机已关闭开发者 LAN 模式。分配仍会保存，但打印机会拒绝服务器下发的槽位设置，并显示“MQTT 命令校验失败”错误。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Entwickler-LAN-Modus ist auf diesem Drucker aus. Die Zuweisung wird trotzdem gespeichert, aber der Drucker lehnt die Slot-Einstellungen Ihres Servers ab und zeigt den Fehler „MQTT command verification failed“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode LAN développeur est désactivé sur cette imprimante. L’attribution est tout de même enregistrée, mais l’imprimante refusera les réglages d’emplacement envoyés par votre serveur et affichera l’erreur « MQTT command verification failed »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo LAN de desarrollador está desactivado en esta impresora. La asignación se guarda igualmente, pero la impresora rechazará los ajustes de ranura que envíe su servidor y mostrará el error «MQTT command verification failed»."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità LAN sviluppatore è disattivata su questa stampante. L’assegnazione viene comunque salvata, ma la stampante rifiuterà le impostazioni dello slot inviate dal server e mostrerà l’errore «MQTT command verification failed»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo LAN de desenvolvedor está desativado nesta impressora. A atribuição ainda é salva, mas a impressora rejeitará os ajustes de slot enviados pelo servidor e mostrará o erro \"MQTT command verification failed\"."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De LAN-ontwikkelaarsmodus staat uit op deze printer. Toewijzen wordt toch bewaard, maar de printer weigert de slotinstellingen die je server stuurt en toont de fout ‘MQTT command verification failed’."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utvecklar-LAN-läget är avstängt på den här skrivaren. Tilldelningen sparas ändå, men skrivaren avvisar facksinställningarna som servern skickar och visar felet ”MQTT command verification failed”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb LAN dewelopera jest wyłączony w tej drukarce. Przypisanie i tak zostanie zapisane, ale drukarka odrzuci ustawienia slotu wysłane przez serwer i pokaże błąd „MQTT command verification failed”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом принтере выключен режим LAN для разработчиков. Назначение всё равно сохранится, но принтер отклонит настройки слота от сервера и покажет ошибку «MQTT command verification failed»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цьому принтері вимкнено режим LAN для розробників. Призначення все одно збережеться, але принтер відхилить налаштування слота від сервера й покаже помилку «MQTT command verification failed»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yazıcıda Geliştirici LAN modu kapalı. Atama yine de kaydedilir, ancak yazıcı sunucunuzun gönderdiği yuva ayarlarını reddeder ve “MQTT command verification failed” hatası gösterir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプリンターの開発者 LAN モードがオフです。割り当ては保存されますが、サーバーが送るスロット設定をプリンターが拒否し、「MQTT command verification failed」エラーを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프린터의 개발자 LAN 모드가 꺼져 있습니다. 할당은 저장되지만, 프린터가 서버에서 보낸 슬롯 설정을 거부하고 \"MQTT command verification failed\" 오류를 표시합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此印表機的開發者 LAN 模式已關閉。指派仍會儲存，但印表機會拒絕伺服器傳送的槽位設定，並顯示「MQTT command verification failed」錯誤。"
          }
        }
      }
    },
