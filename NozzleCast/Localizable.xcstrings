    "Not connected to your server. Pull to refresh and try again." : {
      "comment" : "Error message displayed when the user tries to perform an action while not connected to a server.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
