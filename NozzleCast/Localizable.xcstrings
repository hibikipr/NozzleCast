    },
    "This Bambu Lab tag isn't linked to any spool in your inventory yet." : {
      "comment" : "SpoolBuddy scan: unknown Bambu tag",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bambu Lab-Tag ist noch mit keiner Spule in Ihrem Bestand verknüpft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta etiqueta de Bambu Lab aún no está vinculada a ninguna bobina de su inventario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette étiquette Bambu Lab n’est encore associée à aucune bobine de votre inventaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
