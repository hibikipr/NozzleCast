    "Nothing queued. Jobs added to your server's print queue show up here." : {
      "comment" : "Empty print queue",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "队列为空。添加到服务器打印队列的任务会显示在这里。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts in der Warteschlange. Aufträge aus der Druckwarteschlange Ihres Servers erscheinen hier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
