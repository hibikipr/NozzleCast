    },
    "Your server records it as done now and restarts its interval." : {
      "comment" : "Explains marking a maintenance task done",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器将记录为已完成，并重新开始计时周期。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
