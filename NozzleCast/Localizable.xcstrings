        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak wyników w Open Filament Database i SpoolmanDB-Community. Uzupełnij dane poniżej, a szpula zostanie dodana tak, jak je wpiszesz."
