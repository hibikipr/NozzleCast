    "Nothing queued. Jobs added to your server's print queue show up here." : {
      "comment" : "Empty print queue",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts in der Warteschlange. Aufträge aus der Druckwarteschlange Ihres Servers erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en cola. Los trabajos añadidos a la cola de impresión de su servidor aparecen aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien en file. Les tâches ajoutées à la file d’impression de votre serveur apparaissent ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente in coda. I lavori aggiunti alla coda di stampa del server compaiono qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューは空です。サーバーの印刷キューに追加したジョブがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기열이 비어 있습니다. 서버의 인쇄 대기열에 추가한 작업이 여기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets in de wachtrij. Taken die aan de printwachtrij van je server worden toegevoegd, verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolejka jest pusta. Zadania dodane do kolejki druku na serwerze pojawią się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada na fila. Os trabalhos adicionados à fila de impressão do servidor aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очередь пуста. Задания, добавленные в очередь печати сервера, появятся здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget i kön. Jobb som läggs i serverns utskriftskö visas här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuyrukta bir şey yok. Sunucunuzun baskı kuyruğuna eklenen işler burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Черга порожня. Завдання, додані до черги друку сервера, з’являться тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "队列为空。添加到服务器打印队列的任务会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "佇列中沒有項目。加入伺服器列印佇列的工作會顯示在這裡。"
          }
        }
      }
    },
    "Nothing to buy. Long-press a spool in your inventory to add its filament here." : {
      "comment" : "Empty shopping list",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts zu kaufen. Halten Sie eine Spule im Bestand gedrückt, um ihr Filament hier hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada que comprar. Mantenga pulsada una bobina de su inventario para añadir aquí su filamento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à acheter. Appuyez longuement sur une bobine de votre inventaire pour ajouter son filament ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente da comprare. Tieni premuta una bobina nell’inventario per aggiungere qui il suo filamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入するものはありません。在庫のスプールを長押しすると、そのフィラメントをここに追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "살 것이 없습니다. 재고에서 스풀을 길게 눌러 해당 필라멘트를 여기에 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets te kopen. Houd een spoel in je voorraad ingedrukt om het filament hier toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic do kupienia. Przytrzymaj szpulę w magazynie, aby dodać tu jej filament."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada para comprar. Toque e segure um carretel no estoque para adicionar o filamento dele aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупать нечего. Нажмите и удерживайте катушку в запасах, чтобы добавить сюда её филамент."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget att köpa. Håll ned en rulle i lagret för att lägga till dess filament här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alınacak bir şey yok. Filamentini buraya eklemek için envanterdeki bir makaraya uzun basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нічого купувати. Натисніть і утримуйте котушку в інвентарі, щоб додати сюди її філамент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂无待购项。长按库存中的耗材卷即可将其耗材加入此处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有要買的東西。在庫存中長按料盤即可將其耗材加入這裡。"
          }
        }
      }
    },
