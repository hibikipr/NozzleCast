        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je server stuurt zijn meldingen naar je relay, die ze hierheen pusht, zonder de gedempte. NozzleCast heeft daarvoor geen ntfy of Firebase-configuratie nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer wysyła alerty do twojego przekaźnika, który przekazuje je tutaj, pomijając wyciszone. NozzleCast nie potrzebuje do nich ntfy ani konfiguracji Firebase."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor envia os alertas para o seu relay, que os envia para cá, deixando de fora os que você silenciou. O NozzleCast não precisa do ntfy nem de uma configuração do Firebase para eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер отправляет оповещения на ваш ретранслятор, который присылает их сюда, кроме отключённых. Для них NozzleCast не нужны ни ntfy, ни конфигурация Firebase."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern skickar sina larm till ditt relä, som pushar dem hit, utom dem du har tystat. NozzleCast behöver varken ntfy eller en Firebase-konfiguration för dem."
