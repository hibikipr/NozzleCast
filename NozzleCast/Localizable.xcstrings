        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Druck wird abgebrochen und kann nicht fortgesetzt werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’impression sera annulée et ne pourra pas être reprise."
          }
