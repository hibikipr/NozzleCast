        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunuz bunu şimdi yapıldı olarak kaydeder ve aralığını yeniden başlatır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
