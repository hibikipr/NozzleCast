    "%@ · the printer reports this loaded, but it isn't matched to inventory yet" : {
      "comment" : "AMS slot: raw material label, then explanation that it needs to be matched to an inventory spool",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · der Drucker meldet dies als geladen, es ist aber noch keiner Spule im Bestand zugeordnet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · la impresora indica que está cargado, pero aún no está vinculado al inventario"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · l’imprimante indique ce filament comme chargé, mais il n’est encore associé à aucune bobine de l’inventaire"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · la stampante lo segnala come caricato, ma non è ancora abbinato all’inventario"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · プリンターは装填済みと報告していますが、まだ在庫と紐付けられていません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · 프린터가 장착된 것으로 보고하지만 아직 재고와 연결되지 않았습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · de printer meldt dit als geladen, maar het is nog niet aan de voorraad gekoppeld"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · drukarka zgłasza ten filament jako załadowany, ale nie jest on jeszcze powiązany z magazynem"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
