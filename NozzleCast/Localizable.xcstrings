    "%@ %@ %@ will be removed for good, including its usage history." : {
      "comment" : "Delete confirmation message for an already-archived spool",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ %3$@ will be removed for good, including its usage history."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ 将被永久删除，包括其使用记录。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ wird endgültig entfernt, einschließlich des Nutzungsverlaufs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ sera supprimée définitivement, avec son historique d’utilisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ se eliminará definitivamente, incluido su historial de uso."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ verrà rimossa definitivamente, insieme alla cronologia d’uso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ será removido para sempre, incluindo o histórico de uso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ wordt definitief verwijderd, inclusief de gebruiksgeschiedenis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ tas bort permanent, inklusive användningshistoriken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ zostanie usunięta na zawsze, razem z historią użycia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ будет удалена навсегда вместе с историей использования."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ буде видалено назавжди разом з історією використання."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@, kullanım geçmişiyle birlikte kalıcı olarak silinecek."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ を使用履歴ごと完全に削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@이(가) 사용 기록과 함께 영구적으로 삭제됩니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ 將連同使用紀錄永久移除。"
          }
        }
      }
    },
    "%@ %@ %@ will be removed from your inventory for good, including its usage history. Archive it instead to keep the record." : {
      "comment" : "Delete spool confirmation message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ %3$@ will be removed from your inventory for good, including its usage history. Archive it instead to keep the record."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ 将从库存中永久删除，包括其使用记录。建议改为归档以保留记录。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ wird endgültig aus Ihrem Bestand entfernt, einschließlich des Nutzungsverlaufs. Archivieren Sie die Spule stattdessen, um den Eintrag zu behalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ sera supprimée définitivement de votre inventaire, avec son historique d’utilisation. Archivez-la plutôt pour garder une trace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ se eliminará definitivamente de su inventario, incluido su historial de uso. Archívela en su lugar para conservar el registro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ verrà rimossa definitivamente dal tuo inventario, insieme alla cronologia d’uso. Archiviala invece per conservarne la traccia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ será removido do seu estoque para sempre, incluindo o histórico de uso. Arquive-o em vez disso para manter o registro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ wordt definitief uit je voorraad verwijderd, inclusief de gebruiksgeschiedenis. Archiveer de spoel liever om de gegevens te bewaren."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ tas bort permanent från ditt lager, inklusive användningshistoriken. Arkivera den i stället för att behålla posten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ zostanie na zawsze usunięta z magazynu, razem z historią użycia. Zamiast tego zarchiwizuj ją, aby zachować wpis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ будет навсегда удалена из запасов вместе с историей использования. Чтобы сохранить запись, лучше отправьте её в архив."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ буде назавжди видалено з інвентарю разом з історією використання. Щоб зберегти запис, краще архівуйте котушку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@, kullanım geçmişiyle birlikte envanterinizden kalıcı olarak silinecek. Kaydı korumak için bunun yerine arşivleyin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ を使用履歴ごと在庫から完全に削除します。記録を残すにはアーカイブしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@이(가) 사용 기록과 함께 재고에서 영구적으로 삭제됩니다. 기록을 남기려면 대신 보관하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@ 將連同使用紀錄從庫存中永久移除。若要保留紀錄，請改為封存。"
          }
        }
      }
    },
