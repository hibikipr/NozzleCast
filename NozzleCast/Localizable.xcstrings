          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスプールの検索中にサーバーでエラーが発生しました。もう一度 SpoolBuddy に置いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스풀을 검색하는 중 서버에서 오류가 발생했습니다. SpoolBuddy에 다시 올려놓으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je server kreeg een fout bij het opzoeken van deze spoel. Leg hem opnieuw op de SpoolBuddy."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer napotkał błąd podczas wyszukiwania tej szpuli. Połóż ją ponownie na SpoolBuddy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor teve um erro ao pesquisar este carretel. Coloque-o de novo no SpoolBuddy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На сервере произошла ошибка при поиске этой катушки. Положите её на SpoolBuddy ещё раз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern fick ett fel när den slog upp den här rullen. Lägg den på SpoolBuddy igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunuz bu makarayı ararken bir hatayla karşılaştı. Makarayı SpoolBuddy’ye yeniden koyun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На сервері сталася помилка під час пошуку цієї котушки. Покладіть її на SpoolBuddy ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器查询此耗材时出错，请重新放到 SpoolBuddy 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的伺服器在查詢此料盤時發生錯誤。請再將它放到 SpoolBuddy 上。"
          }
        }
      }
    },
    "Your server records it as done now and restarts its interval." : {
      "comment" : "Explains marking a maintenance task done",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Server vermerkt sie jetzt als erledigt und startet das Intervall neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su servidor la registra como hecha ahora y reinicia su intervalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur l’enregistre comme faite maintenant et relance son intervalle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server la registra come fatta ora e fa ripartire l’intervallo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーは今の時点で完了として記録し、間隔をリセットします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 지금 완료로 기록하고 주기를 다시 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je server registreert hem nu als gedaan en start het interval opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer zapisze je jako wykonane teraz i rozpocznie odliczanie od nowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor registra como feito agora e reinicia o intervalo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер отметит её выполненной сейчас и начнёт интервал заново."
          }
        },
        "sv" : {
