    "Used for future AMS slot configuration — matching this to the spool's real print temperature matters once that's wired up." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于后续 AMS 槽位配置；待该功能接入后，与耗材实际打印温度的匹配将十分重要。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für die künftige AMS-Slot-Konfiguration verwendet – die Übereinstimmung mit der echten Drucktemperatur der Spule zählt, sobald das angebunden ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour la future configuration des emplacements AMS — l’accord avec la vraie température d’impression de la bobine comptera une fois cette fonction en place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para la futura configuración de ranuras del AMS: que coincida con la temperatura real de impresión de la bobina importará cuando eso esté conectado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato per la futura configurazione degli slot AMS: farlo corrispondere alla reale temperatura di stampa della bobina conterà quando sarà collegato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado na futura configuração de slots do AMS — coincidir com a temperatura real de impressão do carretel vai importar quando isso estiver integrado."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt voor toekomstige AMS-slotconfiguratie — overeenstemming met de echte printtemperatuur van de spoel telt zodra dat is aangesloten."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för framtida AMS-fackkonfiguration – att den stämmer med rullens verkliga utskriftstemperatur spelar roll när det är inkopplat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane do przyszłej konfiguracji slotów AMS — zgodność z rzeczywistą temperaturą druku szpuli będzie mieć znaczenie, gdy zostanie to podłączone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для будущей настройки слотов AMS — совпадение с реальной температурой печати катушки будет важно, когда это подключат."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовується для майбутнього налаштування слотів AMS — збіг із реальною температурою друку котушки матиме значення, коли це підключать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelecekteki AMS yuvası yapılandırması için kullanılır — makaranın gerçek baskı sıcaklığıyla eşleşmesi, bu bağlandığında önem kazanacak."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後の AMS スロット設定に使用します。この機能が実装されると、スプールの実際の印刷温度と一致していることが重要になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "향후 AMS 슬롯 설정에 사용됩니다. 기능이 연결되면 스풀의 실제 인쇄 온도와 맞는지가 중요해집니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於未來的 AMS 槽位設定 — 功能接上後，是否與料盤實際列印溫度相符將會很重要。"
          }
        }
      }
    },
