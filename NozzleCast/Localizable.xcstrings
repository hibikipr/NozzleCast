        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast は、サーバーが通知プロバイダに送ったアラートをサーバーの通知ログから読み取ります。App の更新時と、iOS が許可したときにバックグラウンドで確認するため、遅れて届くことがあります。すぐに受け取るには、サーバーにお使いのリレーの /bambuddy/alerts を宛先とする Webhook プロバイダを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast는 서버가 알림 제공자에게 보낸 경고를 서버의 알림 로그에서 읽습니다. 앱을 새로 고칠 때와 iOS가 허용할 때 백그라운드에서 확인하므로 늦게 도착할 수 있습니다. 즉시 받으려면 서버에 사용 중인 릴레이의 /bambuddy/alerts를 가리키는 Webhook 제공자를 추가하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast 會從伺服器的通知紀錄讀取伺服器傳給通知提供者的警報，在 App 重新整理時以及 iOS 允許時於背景檢查，因此可能延遲送達。若要即時收到警報，請在伺服器上新增指向你的中繼伺服器 /bambuddy/alerts 的 Webhook 提供者。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast 会在应用刷新时以及 iOS 允许的后台时机，从通知日志读取服务器发送给各通知渠道的告警，因此告警可能延迟到达。如需即时告警，请在服务器上添加指向你的中继 /bambuddy/alerts 的 Webhook 渠道。"
          }
        }
      }
    },
    "NozzleCast stops receiving ntfy pushes and reads your server's alerts from its notification log instead, which can be late." : {
      "comment" : "Confirmation message when nothing else pushes alerts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NozzleCast stops receiving ntfy pushes and reads your server's alerts from its notification log instead, which can be late."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast 停止接收 ntfy 推送，改为从服务器通知日志读取告警，可能有延迟。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast empfängt keine ntfy-Pushes mehr und liest die Warnungen Ihres Servers stattdessen aus seinem Benachrichtigungsprotokoll, was verspätet sein kann."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast ne reçoit plus les notifications push ntfy et lit plutôt les alertes de votre serveur dans son journal de notifications, ce qui peut prendre du retard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast deja de recibir avisos push de ntfy y lee las alertas de su servidor desde su registro de notificaciones, lo que puede llegar con retraso."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast smette di ricevere le notifiche push di ntfy e legge invece gli avvisi del server dal suo registro notifiche, che può essere in ritardo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NozzleCast deixa de receber pushes do ntfy e passa a ler os alertas do servidor no registro de notificações dele, o que pode atrasar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast ontvangt geen ntfy-pushes meer en leest de meldingen van je server voortaan uit het meldingslogboek, wat vertraging kan geven."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast slutar ta emot ntfy-pushar och läser i stället serverns larm från dess notislogg, vilket kan dröja."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast przestaje odbierać powiadomienia push z ntfy i zamiast tego odczytuje alerty serwera z jego dziennika powiadomień, co może się opóźniać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast перестаёт получать push-уведомления ntfy и читает оповещения сервера из его журнала уведомлений, а это может быть с задержкой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast перестає отримувати push-сповіщення ntfy і читає сповіщення сервера з його журналу сповіщень, а це може бути із затримкою."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast ntfy anlık bildirimlerini almayı bırakır ve sunucunuzun uyarılarını bunun yerine bildirim günlüğünden okur; bu gecikebilir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast は ntfy のプッシュ通知の受信をやめ、代わりにサーバーの通知ログからアラートを読み取ります。遅れることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast는 ntfy 푸시를 더 이상 받지 않고 대신 서버의 알림 로그에서 경고를 읽습니다. 늦어질 수 있습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast 將停止接收 ntfy 推播，改為從伺服器的通知紀錄讀取警報，可能會延遲。"
          }
        }
      }
    },
