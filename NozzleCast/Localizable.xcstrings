          }
        }
      }
    },
    "These printers and spools are samples. Connect your server in Settings to see your own." : {
      "comment" : "Demo data banner: no server configured",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Drucker und Spulen sind Beispiele. Verbinden Sie Ihren Server in den Einstellungen, um Ihre eigenen zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas impresoras y bobinas son de ejemplo. Conecte su servidor en Ajustes para ver las suyas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces imprimantes et bobines sont des exemples. Connectez votre serveur dans les Réglages pour voir les vôtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste stampanti e bobine sono esempi. Collega il tuo server nelle Impostazioni per vedere le tue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらはサンプルのプリンターとスプールです。ご自身のものを見るには、設定でサーバーを接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프린터와 스풀은 샘플입니다. 내 것을 보려면 설정에서 서버를 연결하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
