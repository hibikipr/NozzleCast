    "NozzleCast %@" : {
      "comment" : "App name and version in Settings",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NozzleCast %@"
          }
        },
        "de" : {
