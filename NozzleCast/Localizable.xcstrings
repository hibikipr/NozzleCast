          }
        }
      }
    },
    "Nothing to buy. Long-press a spool in your inventory to add its filament here." : {
      "comment" : "Empty shopping list",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
