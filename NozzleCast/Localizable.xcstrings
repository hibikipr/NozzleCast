            "value" : "Вони надходять без звуку й не потрапляють до списку сповіщень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些将静默送达，不出现在通知列表中。"
          }
        },
        "zh-Hant" : {
