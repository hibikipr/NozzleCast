          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlar sessizce gelir ve Bildirimler listesinde görünmez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらは通知音なしで届き、通知リストには表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 경고는 소리 없이 도착하며 알림 목록에 표시되지 않습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些警報會靜音送達，且不會出現在通知列表中。"
          }
        }
      }
    },
    "These printers and spools are samples. Connect your server in Settings to see your own." : {
      "comment" : "Demo data banner: no server configured",
      "localizations" : {
