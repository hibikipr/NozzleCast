    "For a dual/multi-color or gradient-effect spool. Leave blank for a plain single color." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für eine zwei-/mehrfarbige Spule oder eine Spule mit Farbverlauf. Bei einer einfarbigen Spule leer lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para una bobina bicolor/multicolor o con efecto degradado. Déjelo en blanco para un color liso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une bobine bicolore/multicolore ou à effet dégradé. Laissez vide pour une couleur unie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per una bobina bicolore/multicolore o con effetto sfumato. Lascia vuoto per un colore unico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デュアル／マルチカラーまたはグラデーション効果のスプール用。単色の場合は空欄のままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듀얼/멀티 컬러 또는 그라데이션 효과 스풀용입니다. 단색이면 비워 두세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor een twee-/meerkleurige spoel of een spoel met kleurverloop. Leeg laten voor één effen kleur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla szpuli dwu-/wielokolorowej lub z efektem gradientu. Zostaw puste dla jednolitego koloru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para um carretel bicolor/multicolor ou com efeito gradiente. Deixe em branco para uma cor única."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для двух-/многоцветной катушки или с эффектом градиента. Оставьте пустым для одного цвета."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För en två-/flerfärgad rulle eller en med gradienteffekt. Lämna tomt för en enfärgad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çift/çok renkli veya gradyan efektli bir makara için. Düz tek renk için boş bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для дво-/багатоколірної котушки або з ефектом градієнта. Залиште порожнім для одного кольору."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于双色/多色或渐变效果耗材；纯色请留空。"
