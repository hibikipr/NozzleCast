    "Leave empty for Automatic, which shows the print that finishes soonest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen für Automatisch: zeigt den Druck, der als Nächstes fertig wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour Automatique, qui affiche l’impression qui se termine le plus tôt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjelo vacío para Automático, que muestra la impresión que termina antes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto per Automatico, che mostra la stampa che finisce per prima."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe vazio para Automático, que mostra a impressão que termina primeiro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leeg laten voor Automatisch, dat de print toont die het eerst klaar is."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämna tomt för Automatiskt, som visar utskriften som blir klar först."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaw puste dla trybu Automatycznie, który pokazuje wydruk kończący się najwcześniej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте пустым для «Автоматически» — будет показана печать, которая закончится раньше всех."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залиште порожнім для «Автоматично» — буде показано друк, що завершиться найраніше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik için boş bırakın; en önce bitecek baskıyı gösterir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄にすると自動になり、最も早く終わる印刷を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동으로 두려면 비워 두세요. 가장 먼저 끝나는 인쇄를 표시합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空即為「自動」，會顯示最快完成的列印。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空即为“自动”，显示最先完成的打印。"
          }
        }
      }
    },
