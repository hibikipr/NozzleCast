# App Store Connect API credentials for the fastlane lanes (metadata_pull,
# metadata_push, upload_screenshots).
#
#   cp .env.asc.example .env.asc   # .env.asc is gitignored
#   # fill in the values below, then before running a lane:
#   source .env.asc
#
# Create the API key in App Store Connect → Users and Access → Integrations →
# App Store Connect API. Never commit .env.asc or the .p8 file.

# Key ID shown next to the API key (10 characters).
export ASC_KEY_ID="XXXXXXXXXX"

# Issuer ID shown at the top of the API keys page (a UUID).
export ASC_ISSUER_ID="00000000-0000-0000-0000-000000000000"

# Absolute path to the downloaded AuthKey_<KEY_ID>.p8 private key.
# Keep it outside the repo.
export ASC_KEY_PATH="$HOME/.appstoreconnect/AuthKey_XXXXXXXXXX.p8"

# Numeric Apple ID of the app (App Store Connect → App Information).
export ASC_APP_ID="0000000000"

# Optional: metadata locale to pull/push. Defaults to en-US.
# export ASC_LOCALE="en-US"
